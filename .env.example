# ─── Server ───────────────────────────
PORT=3000

# ─── Redis (BullMQ) ───────────────────
REDIS_URL=redis://localhost:6379
# Controle dos Workers
START_WORKER=true
QUEUE_CONCURRENCY=5
MEMORY_WORKER_CONCURRENCY=2

# ─── MCP Server ──────────────────────
MCP_SERVER_URL=
MCP_API_KEY=

# ─── LLM Provider ────────────────────
# Providers suportados: openai | anthropic | deepseek | google
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ─── Memória de Longo Prazo e Vetores ─
LONG_TERM_MEMORY_ENABLED=true
VECTOR_MEMORY_ENABLED=true
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Auth & Security ───────────────────
# Chave secreta para assinar os tokens JWT (mínimo 32 caracteres recomendado)
JWT_SECRET=your_super_secret_key_here
# Tempo de expiração do token (ex: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h
# Chave de 32 caracteres ou 64-hex para criptografia AES-256-GCM dos tokens de chat
ENCRYPTION_KEY=12345678901234567890123456789012

# ─── Slack ────────────────────────────
# Bot token (começa com xoxb-)
SLACK_BOT_TOKEN=xoxb-
# Signing secret do app (encontrado em App Credentials no Slack API dashboard)
SLACK_SIGNING_SECRET=

# ─── Observabilidade: OpenTelemetry & Grafana Tempo ────
# Nome do serviço nos traces
OTEL_SERVICE_NAME=support-agent
# Endpoint OTLP/HTTP para envio de traces (Grafana Tempo / OTEL Collector)
# Exemplo Local/Docker: http://localhost:4318/v1/traces
# Exemplo Grafana Cloud: https://tempo-prod-xxx.grafana.net/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Headers OTLP adicionais (ex.: Authorization=Basic <token>)
OTEL_EXPORTER_OTLP_HEADERS=
# Habilitar logging de debug do OpenTelemetry se necessário: debug | info
OTEL_LOG_LEVEL=info

# ─── Observabilidade: Loki & Logs ──────────────────────
LOG_LEVEL=info
LOKI_HOST=
LOKI_USER=
LOKI_PASSWORD=

# ─── Observabilidade: Métricas Prometheus ──────────────
METRICS_PORT=9090

# ─── Agent Harness & Execution Policy ─────────────────
# Limite máximo de iterações de ferramentas por execução (padrão: 12)
MAX_TOOL_ITERATIONS=12
# Limite de chamadas idênticas consecutivas da mesma ferramenta antes de abortar por loop (padrão: 2)
MAX_IDENTICAL_TOOL_CALLS=2
# Timeout de execução de ferramentas via MCP em ms (padrão: 25000)
MCP_TIMEOUT_MS=25000
# Timeout de resposta do LLM em ms (padrão: 60000)
LLM_TIMEOUT_MS=60000
# Timeout global de execução do AgentHarness em ms (padrão: 120000)
MAX_RUN_TIME_MS=120000
# Limite de tokens do contexto do agente (padrão: 4096)
MAX_CONTEXT_TOKENS=4096